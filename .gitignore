# ============================
# PyInstaller 相关
# ============================
# 构建临时目录（存放中间文件）
/build/
# 打包输出目录（存放生成的可执行文件）
/dist/
# PyInstaller 规范文件（如果需要版本管理可移除，通常建议忽略）
*.spec

# ============================
# Python 通用缓存
# ============================
# 字节码缓存
__pycache__/
*.py[cod]
*$py.class
# 扩展模块缓存
*.so
*.pyd

# ============================
# 虚拟环境
# ============================
# 常见虚拟环境目录
venv/
env/
.venv/
.env/
virtualenv/
# Pipenv 相关
Pipfile.lock
# Poetry 相关
poetry.lock

# ============================
# 开发工具配置
# ============================
# IDE
.vscode/
.idea/
*.swp
*.swo
*~
# Jupyter Notebook
.ipynb_checkpoints/
# VS Code 设置
.vscode/

# ============================
# 日志、临时文件和数据库
# ============================
*.log
*.tmp
*.temp
*.db
*.sqlite3
*.sqlite
# 覆盖率报告
.coverage
htmlcov/
.tox/
.mypy_cache/
.pytest_cache/

# ============================
# 环境变量和敏感数据
# ============================
# 环境变量文件（包含密钥等）
.env
.env.local
.env.*.local
# 密钥文件
*.key
*.pem
*.crt
*.p12

# ============================
# 操作系统生成文件
# ============================
# macOS
.DS_Store
# Windows
Thumbs.db
desktop.ini

# ============================
# 项目特定（如有需要可自行添加）
# ============================
# 例如自定义配置文件，但保留模板
# config.ini
# *.yaml